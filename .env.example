# Postgres (set by `neon deploy`)
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# BoardGameGeek XML API token (boardgamegeek.com/applications)
BGG_API_TOKEN=

# Box-cover OCR service on the VPS (ocr-service/)
OCR_URL=
OCR_API_KEY=

# Gemini API key (aistudio.google.com, paid tier: free-tier requests may be used for training). Optional:
# without it, photos are matched from OCR alone. GEMINI_MODEL overrides gemini-3.1-flash-lite.
GEMINI_API_KEY=

# Vercel Cron auth for /api/cron/* (any long random string)
CRON_SECRET=
