{
  "name": "meeple-scan",
  "version": "1.1.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "screenshots": "playwright test -c playwright.screenshots.config.ts",
    "vercel-build": "drizzle-kit migrate && next build",
    "import:ranks": "node --env-file=.env.local scripts/import-ranks.ts",
    "export:photo-logs": "node --env-file=.env.local scripts/export-photo-logs.ts",
    "stats": "node --env-file=.env.local scripts/stats.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@neon/config": "^1.9.6",
    "@neon/env": "^1.6.6",
    "@vercel/analytics": "^2.0.1",
    "@vercel/functions": "^3.10.5",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "drizzle-orm": "^0.45.4",
    "drizzle-zod": "^0.8.3",
    "entities": "^6.0.1",
    "fast-xml-parser": "^5.11.2",
    "fuzzball": "^2.2.6",
    "lucide-react": "^1.64.0",
    "motion": "^14.8.0",
    "next": "16.4.3",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.23.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.9",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.12"
  },
  "packageManager": "pnpm@10.34.1"
}
