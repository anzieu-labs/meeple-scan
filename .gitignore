# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.neon


# playwright
/test-results
/playwright-report

# OCR evaluation: Python env, test images, OCR output
/ocr-eval/.venv
/ocr-eval/data
/ocr-eval/out

# BGG data dumps (download from boardgamegeek.com/data_dumps/bg_ranks)
/data/bgg-ranks

# Python bytecode
__pycache__/

# Python bytecode
__pycache__/
*.pyc

# Marketing material (images, post drafts): not part of the app
/marketing
